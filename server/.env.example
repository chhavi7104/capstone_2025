# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string.
# Local example:  mongodb://127.0.0.1:27017/college-discovery
# Atlas example:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/college-discovery
MONGO_URI=mongodb://127.0.0.1:27017/college-discovery

# Port the Express server listens on
PORT=5000

# URL of the frontend allowed to call this API (used for CORS)
CLIENT_URL=http://localhost:5173
